# ── Pick at least ONE ──────────────────────────────────────
# Option A: Anthropic (paid)  https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option B: Google Gemini (FREE tier)  https://aistudio.google.com
GEMINI_API_KEY=

# Option C: Groq (FREE tier — very fast)  https://console.groq.com
GROQ_API_KEY=

# Option D: OpenAI (paid)
OPENAI_API_KEY=

# Option E: Local Ollama (VP/local machine)
# Used for /query and /db/query when cloud keys are absent or by explicit model selection.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_FALLBACK_MODELS=llama3:8b,qwen2.5:7b,phi3:mini
